# Local MongoDB (npm run db:up — requires Docker Desktop)
DATABASE_URL="mongodb://localhost:27017/quillrx"

# MongoDB Atlas (cloud alternative)
# DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quillrx?retryWrites=true&w=majority"

# JWT secret for authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# 32-byte envelope encryption master key for wrapping patient/prescription DEKs
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENVELOPE_ENCRYPTION_MASTER_KEY="base64-encoded-32-byte-key"
ENVELOPE_ENCRYPTION_KEY_ID="local-v1"

# Company console token and IP allowlist for /console and /api/console/*
ADMIN_CONSOLE_TOKEN="change-this-console-token"
ADMIN_CONSOLE_ALLOWED_IPS="127.0.0.1,::1"

# App URL (for generating prescription links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upload directory (local dev) — for production use S3
UPLOAD_DIR="./public/uploads"
