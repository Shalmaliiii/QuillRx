generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Doctor {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  email              String         @unique
  password           String
  fullName           String
  qualification      String
  registrationNumber String
  specialization     String
  mobileNumber       String
  clinicName         String?
  clinicAddress      String?
  consultationTimings String?
  clinicPhone        String?
  signatureUrl       String?
  logoUrl            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  patients           Patient[]
  prescriptions      Prescription[]
  queueEntries       QueueEntry[]
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  DONE
  NO_SHOW
  CANCELLED
}

model QueueEntry {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  doctorId    String      @db.ObjectId
  patientId   String?     @db.ObjectId
  name        String
  age         Int?
  gender      String?
  phone       String?
  reason      String
  duration    String?
  severity    String?
  notes       String?
  tokenNumber Int
  status      QueueStatus @default(WAITING)
  source      String      @default("qr")
  calledAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  doctor      Doctor      @relation(fields: [doctorId], references: [id])

  @@index([doctorId, status])
  @@index([doctorId, createdAt])
}

model Patient {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  doctorId           String         @db.ObjectId
  fullName           String
  age                Int
  gender             String
  phone              String
  weight             String?
  bp                 String?
  diabetesStatus     String?
  allergies          String?
  existingConditions String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  doctor             Doctor         @relation(fields: [doctorId], references: [id])
  prescriptions      Prescription[]

  @@index([doctorId])
  @@index([phone])
}

type Vital {
  bp          String?
  temperature String?
  weight      String?
  pulse       String?
}

type Medicine {
  name                String
  strength            String?
  morning             Boolean  @default(false)
  afternoon           Boolean  @default(false)
  night               Boolean  @default(false)
  beforeFood          Boolean  @default(false)
  duration            String?
  specialInstructions String?
}

model Prescription {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  doctorId          String     @db.ObjectId
  patientId         String     @db.ObjectId
  symptoms          String?
  diagnosis         String?
  vitals            Vital?
  medicines         Medicine[]
  labTests          String?
  advice            String?
  followUpDate      DateTime?
  consultationFee   Float?     @default(0)
  additionalCharges Float?     @default(0)
  discount          Float?     @default(0)
  totalAmount       Float?     @default(0)
  pdfUrl            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  doctor            Doctor     @relation(fields: [doctorId], references: [id])
  patient           Patient    @relation(fields: [patientId], references: [id])

  @@index([doctorId])
  @@index([patientId])
}

model MedicineCatalog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  genericName String
  brandName   String?
  strength    String?
  form        String?
  rxCui       String?
  source      String   @default("local")
  searchText  String
  isEssential Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([searchText])
  @@index([genericName])
}
